rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: chat_sessions
    // Document ID: sessionId (usually user UID or anonymous ID)
    // Fields:
    //   - id: string (required)
    //   - lastMessage: string
    //   - lastTimestamp: timestamp (required)
    //   - userName: string
    //   - unreadCount: number
    //   - status: string (enum: active, archived)
    //
    // Sub-collection: chat_sessions/{sessionId}/messages
    // Document ID: auto-generated
    // Fields:
    //   - sessionId: string (required)
    //   - text: string (required)
    //   - timestamp: timestamp (required)
    //   - isAdmin: boolean (required)
    //   - senderId: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "pengdawei0336@gmail.com" && request.auth.token.email_verified == true);
    }

    function isSessionOwner(sessionId) {
      return (isAuthenticated() && request.auth.uid == sessionId) || (sessionId.matches("^guest_.*"));
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'lastTimestamp']) &&
             data.id is string &&
             data.lastTimestamp is timestamp &&
             (!('lastMessage' in data) || data.lastMessage is string) &&
             (!('userName' in data) || data.userName is string) &&
             (!('unreadCount' in data) || data.unreadCount is number) &&
             (!('status' in data) || data.status in ['active', 'archived']);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['sessionId', 'text', 'timestamp', 'isAdmin', 'senderId']) &&
             data.sessionId is string &&
             data.text is string && data.text.size() < 5000 &&
             data.timestamp is timestamp &&
             data.isAdmin is bool &&
             data.senderId is string &&
             (data.senderId == request.auth.uid || data.senderId.matches("^guest_.*"));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /chat_sessions/{sessionId} {
      allow read: if isAdmin() || isSessionOwner(sessionId);
      allow create: if isValidSession(request.resource.data) && (isSessionOwner(sessionId) || isAdmin());
      allow update: if isValidSession(request.resource.data) && (isSessionOwner(sessionId) || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isAdmin() || isSessionOwner(sessionId);
        allow create: if isValidMessage(request.resource.data) && (isSessionOwner(sessionId) || isAdmin());
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
